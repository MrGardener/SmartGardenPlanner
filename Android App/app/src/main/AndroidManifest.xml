<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- [NEW] Required by core/CameraCaptureManager.kt (T2-FUN-010). Was previously absent
         because no camera code existed in the project at all. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- FR-026: used only while the user's "Online features" switch is on (off by default), and only for
         the approved data services in core/OnlineData.kt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FR-019: daily care reminders (asked for when reminders are switched on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FR-006/007/019: "Use my location" on the plot's Site tab (approximate location is enough). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.SmartGardenPlanner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartGardenPlanner"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
