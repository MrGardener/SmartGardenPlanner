<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-to-device transfer rules.
    The database and its key file are encrypted with a Keystore key that never leaves this device, so a
    restored copy can't be read on another phone (it used to crash the app at every start). Nothing is
    backed up or transferred (T2-SEC-050, HLR-PROT-030).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
